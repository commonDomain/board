{
  "name": "realtime-whiteboard",
  "version": "3.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A reliable, pressure-sensitive realtime collaborative drawing workspace.",
  "main": "backend/server.js",
  "scripts": {
    "setup:push": "node scripts/setup-web-push.cjs",
    "build:vendor": "node scripts/build-vendor.js",
    "build:fonts": "node scripts/build-fonts.js",
    "build:backgrounds": "node scripts/build-background-previews.js",
    "build:text-borders": "node scripts/build-text-border-strips.js",
    "build:text-border-plates": "node scripts/build-text-border-plates.js",
    "build:section-frames": "node scripts/build-section-frames.js",
    "build:section-backdrops": "node scripts/build-section-backdrops.js",
    "transfer:account": "node --env-file-if-exists=.env scripts/transfer-account-canvases.js",
    "recover:backup": "node scripts/restore-backup.js",
    "backup:now": "node --env-file-if-exists=.env scripts/backup-now.js",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "check": "node scripts/check-project.js",
    "build:frontend": "node scripts/build-frontend.js",
    "build": "node scripts/build.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "esbuild": "^0.25.0",
    "ffmpeg-ffprobe-static": "6.1.2-rc.1",
    "gsap": "^3.15.0",
    "lucide": "^0.468.0",
    "perfect-freehand": "^1.2.2",
    "qrcode": "^1.5.4",
    "resend": "^6.26.0",
    "saxes": "^6.0.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "fflate": "^0.8.3",
    "globals": "^17.12.0"
  },
  "allowScripts": {
    "ffmpeg-ffprobe-static@6.1.2-rc.1": true
  }
}
