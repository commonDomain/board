# 将本文件复制为 `.env` 后填写；不要提交真实密钥。

# 运行环境
NODE_ENV=production # 运行环境
HOST=0.0.0.0 # HTTP 与 WebSocket 监听地址；0.0.0.0 表示全部网卡
PORT=4000 # 服务监听端口；0 表示由系统随机分配
DATA_DIR=./data # SQLite 数据库、资源与备份的持久化目录

# 公网地址与请求信任边界
PUBLIC_BASE_URL=http://localhost:4000/ # 本机开发地址；生产部署填写自己的 HTTPS 域名，路径须以斜杠结尾
ALLOWED_ORIGINS=http://localhost:4000 # 允许写请求和 WebSocket 的精确 Origin，多个值用英文逗号分隔
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1 # 允许提供 X-Forwarded-For 的代理源 IP
HSTS_MAX_AGE_SECONDS=0 # HSTS 有效秒数；0 为关闭，仅在完整 HTTPS 部署后开启
HTTPS_ONLY_ENABLED=1 # 除 localhost 外，将普通 HTTP 请求 308 重定向到 HTTPS；反代需传 X-Forwarded-Proto
JS_MINIFY_ENABLED=1 # 启动时压缩并混淆首方浏览器 JavaScript 的标识符、语法和空白
LOGIN_LOG_DIR= # 默认为 DATA_DIR/logs；每天仅保留当天的 login-users-YYYY-MM-DD.log
LOGIN_LOG_TIMEZONE=Asia/Shanghai

# JSON API 应用层加密（HTTPS 仍必须保留）。浏览器临时 ECDH 密钥与服务端主密钥通过 HKDF 派生双向 AES-256-GCM 会话密钥。
API_PAYLOAD_ENCRYPTION_ENABLED=0 # 配好下面的密钥后改为 1；不影响 WebSocket、第三方回调和直接加载的二进制资源
API_PAYLOAD_ENCRYPTION_KEY= # openssl rand -base64 32；只保存在服务端，不得提交或写入前端
API_PAYLOAD_ENCRYPTION_SESSION_TTL_MS=600000 # 单个浏览器加密会话有效期；前端会在到期前自动换新
API_PAYLOAD_ENCRYPTION_MAX_SESSIONS=10000 # 服务端同时保留的加密会话上限
API_PAYLOAD_ENCRYPTION_CLOCK_SKEW_MS=60000 # 请求时间戳允许偏差和重放 nonce 保留时间
MAX_ENCRYPTED_API_PAYLOAD=100663296 # 加密信封最大字节数，应高于最大的明文接口载荷

# Passkey / WebAuthn 身份认证
PASSKEY_AUTH_ENABLED=1 # Passkey 登录、注册、恢复和管理总开关
PASSKEY_RP_NAME="Muse Board" # Passkey 验证界面展示的站点名称
PASSKEY_RP_ID=localhost # WebAuthn RP ID，只填写域名
PASSKEY_EXPECTED_ORIGIN=http://localhost:4000 # WebAuthn 响应必须匹配的精确 Origin
AUTH_CHALLENGE_TTL_MS=600000 # Passkey 一次性挑战有效期，单位毫秒
RECENT_AUTH_TTL_MS=300000 # 新增登录方式前的一次性身份确认有效期，绑定当前会话和具体操作
DEVICE_PAIRING_TTL_MS=300000 # 手机扫码授权链接有效期，单位毫秒
SESSION_TTL_MS=1209600000 # 登录会话绝对有效期，单位毫秒

# 账号功能开关
REGISTRATION_ENABLED=1 # 新账号注册总开关；关闭后已有账号仍可登录
GUEST_MODE_ENABLED=1 # 登录页游客模式入口开关
SHARING_ENABLED=1 # 实时共享及跨账号画布访问总开关
SHARING_MAX_MEMBERS=5 # 单个共享组最大成员数，包含所有者

# Resend 邮箱认证
EMAIL_AUTH_ENABLED=0 # Resend 邮箱认证总开关；填好密钥后改为 1
RESEND_API_KEY= # Resend 服务端 API Key
RESEND_FROM="Museboard <login@example.com>" # 示例地址；开启邮箱认证前替换为已验证的发件人邮箱
RESEND_REPLY_TO= # 可选回复邮箱；为空时不设置 Reply-To
RESEND_WEBHOOK_SECRET= # Resend Webhook 的 whsec_ 签名密钥
RESEND_MAX_ATTEMPTS=3 # 瞬时投递故障的最多发送尝试次数
RESEND_RETRY_BASE_MS=350 # Resend 重试基础等待时间，单位毫秒
EMAIL_LINK_TTL_MS=900000 # 邮箱魔法链接有效期，单位毫秒
EMAIL_RESEND_COOLDOWN_MS=60000 # 同邮箱再次发送的冷却时间，单位毫秒
EMAIL_HOURLY_LIMIT=5 # 单邮箱每小时允许发送的最大次数
RESEND_REQUEST_TIMEOUT_MS=10000 # Resend 单次请求超时
MAX_PASSKEYS_PER_ACCOUNT=10 # 单账号 Passkey 上限
MAX_SESSIONS_PER_ACCOUNT=20 # 单账号有效会话上限
EMAIL_REQUEST_RETENTION_MS=86400000 # 邮箱认证请求记录保留时间，单位毫秒
RESEND_EVENT_RETENTION_MS=2592000000 # Webhook 幂等事件记录保留时间，单位毫秒

# 画布外观
WALLPAPER_DRIFT_ENABLED=1 # 高清图景背景漂移的默认状态；画板未保存过该设置时使用，1 开启，0 关闭
WALLPAPER_DRIFT_PARALLAX=50 # 背景漂移强度，取画布平移量的百分比；0 完全静止，100 与画布等速

# 高德地图导航；JS Key 需绑定站点域名，Web 服务 Key 需绑定服务器出口 IP 并开启数字签名
AMAP_ENABLED=0 # 总开关；密钥不完整时即使设为 1 也保持不可用
AMAP_JS_KEY= # 高德 Web 端（JS API）Key
AMAP_JS_SECURITY_CODE= # JS API 安全密钥，仅由服务端安全代理使用
AMAP_WEB_SERVICE_KEY= # 高德 Web 服务 Key，仅保存在服务端
AMAP_WEB_SERVICE_PRIVATE_KEY= # Web 服务数字签名私钥
AMAP_USAGE_HASH_SECRET= # 用于 HMAC 匿名化客户端 IP 的独立随机密钥
AMAP_QUOTA_TIMEZONE=Asia/Shanghai # 日/月额度重置时区
AMAP_MAX_NAV_ITEMS_PER_USER=3 # 单账号可创建的每类导航组件上限
AMAP_REQUEST_TIMEOUT_MS=6000 # 单次高德上游请求超时
AMAP_MAX_RESPONSE_BYTES=2097152 # 单次高德响应最大字节数
AMAP_MAX_CONCURRENCY=8 # 高德上游最大并发
AMAP_ACCOUNT_RATE_PER_MINUTE=20 # 单账号每分钟导航 API 请求上限，缓存命中也计数
AMAP_IP_RATE_PER_MINUTE=40 # 单 IP 每分钟导航 API 请求上限，缓存命中也计数
AMAP_GLOBAL_QPS=5 # 全服务每秒导航 API 请求上限
AMAP_FAILURE_THRESHOLD=5 # 连续失败多少次后开启熔断
AMAP_CIRCUIT_OPEN_MS=60000 # 熔断持续时间

# XMind 官方 MCP（国际版 app.xmind.com / 中文版 app.xmind.cn）。每个账号只保存一个站点的令牌，并使用 32 字节 AES-GCM 密钥加密。
XMIND_MCP_ENABLED=0
XMIND_TOKEN_ENCRYPTION_KEY= # 例如：openssl rand -base64 32；必须与数据库备份分开保存
XMIND_TOKEN_ENCRYPTION_PREVIOUS_KEYS= # 轮换时临时填写逗号分隔的旧密钥，旧密文全部刷新后移除
XMIND_REQUEST_TIMEOUT_MS=15000
XMIND_MAX_RESPONSE_BYTES=4194304
AMAP_CACHE_SEARCH_MS=86400000 # 搜索与输入提示缓存时间
AMAP_CACHE_ROUTE_MS=300000 # 路线规划缓存时间
AMAP_CACHE_LOCATE_MS=604800000 # 定位与逆地理编码缓存时间
AMAP_SEARCH_ACCOUNT_DAY_LIMIT=40
AMAP_SEARCH_ACCOUNT_MONTH_LIMIT=800
AMAP_SEARCH_IP_DAY_LIMIT=80
AMAP_SEARCH_IP_MONTH_LIMIT=2000
AMAP_SEARCH_GLOBAL_DAY_LIMIT=90
AMAP_SEARCH_GLOBAL_MONTH_LIMIT=2500
AMAP_ROUTE_ACCOUNT_DAY_LIMIT=30
AMAP_ROUTE_ACCOUNT_MONTH_LIMIT=600
AMAP_ROUTE_IP_DAY_LIMIT=60
AMAP_ROUTE_IP_MONTH_LIMIT=1500
AMAP_ROUTE_GLOBAL_DAY_LIMIT=4000
AMAP_ROUTE_GLOBAL_MONTH_LIMIT=100000
AMAP_LOCATE_ACCOUNT_DAY_LIMIT=50
AMAP_LOCATE_ACCOUNT_MONTH_LIMIT=1000
AMAP_LOCATE_IP_DAY_LIMIT=100
AMAP_LOCATE_IP_MONTH_LIMIT=3000
AMAP_LOCATE_GLOBAL_DAY_LIMIT=4000
AMAP_LOCATE_GLOBAL_MONTH_LIMIT=100000

# 画布、载荷与连接限制
MAX_CLIENTS_PER_BOARD=25 # 单个画板最大 WebSocket 连接数
MAX_WEBSOCKET_CLIENTS=500 # 全服务 WebSocket 连接总上限
MAX_ASSET_SIZE=15728640 # 单个普通上传资源最大字节数
MAX_IMAGE_PIXELS=80000000 # 普通图片最大解码像素总数
MAX_AVATAR_SIZE=5242880 # 头像上传最大字节数
MAX_AVATAR_PIXELS=20000000 # 头像原图最大解码像素总数
AVATAR_OUTPUT_SIZE=256 # 服务端生成头像的正方形边长，单位像素
AVATAR_UPLOAD_RATE_LIMIT=6 # 单账号及单 IP 在头像上传窗口内允许的处理次数
AVATAR_UPLOAD_RATE_WINDOW_MS=60000 # 头像上传专用限流窗口，单位毫秒
IMAGE_PROCESSING_CONCURRENCY=2 # Sharp/libvips 并行处理线程数
MAX_CANVASES=10 # 单账号或游客最多拥有的画布数
MAX_CANVAS_NAME_LENGTH=30 # 画布名称最大 Unicode 字符数
MAX_PREVIEW_SIZE=524288 # 单个画布 WebP 预览最大字节数
MAX_BOARD_ITEMS=5000 # 单个画板最大对象数
MAX_SECTIONS=500 # 单个画板最大画框数
MAX_GROUPS=1000 # 单个画板最大分组数
MAX_GROUP_DEPTH=16 # 分组最大嵌套层级
SEARCH_RESULT_LIMIT=50 # 单次全局搜索最大结果数
MAX_STATE_BYTES=25165824 # 单个画板序列化状态最大字节数
BOARD_CACHE_MAX_ENTRIES=100 # 服务端最多保留的已加载画板数；在线画板不会被淘汰
BOARD_CACHE_MAX_BYTES=268435456 # 服务端画板状态缓存总字节软上限；不得小于 MAX_STATE_BYTES
BOARD_CACHE_IDLE_MS=900000 # 无客户端画板的缓存空闲寿命，单位毫秒
BOARD_CACHE_SWEEP_MS=60000 # 服务端画板缓存扫描间隔，单位毫秒
MAX_MESSAGE_SIZE=33554432 # 单条 WebSocket 消息最大字节数
MAX_CLIENT_QUEUE_BYTES=33554432 # 单客户端待发送缓冲上限字节数
MAX_CLIENT_INBOUND_QUEUE_BYTES=50331648 # 单客户端尚待处理的入站消息累计字节上限
MAX_CLIENT_INBOUND_MESSAGES=64 # 单客户端尚待处理的入站消息数量上限
SNAPSHOT_CHUNK_THRESHOLD_BYTES=4194304 # 超过此大小的快照改用分片传输
SNAPSHOT_CHUNK_BYTES=262144 # 每个快照分片的目标字节数
HEARTBEAT_INTERVAL_MS=30000 # WebSocket 心跳间隔，单位毫秒
JOIN_TIMEOUT_MS=10000 # 客户端加入画板最长等待时间，单位毫秒
MAX_HTTP_CONNECTIONS=1000 # HTTP 并发连接总上限
MAX_REQUESTS_PER_SOCKET=100 # 单个 keep-alive 连接最多处理的请求数
HTTP_HEADERS_TIMEOUT_MS=15000 # 完整接收 HTTP 请求头的超时，单位毫秒
HTTP_REQUEST_TIMEOUT_MS=30000 # 完整接收 HTTP 请求的超时，单位毫秒
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000 # 空闲 keep-alive 连接保留时间，单位毫秒

# 进程内存与磁盘安全水位
MAX_DATA_DIR_BYTES=21474836480 # DATA_DIR 的软容量上限；达到后拒绝新增写入
MIN_FREE_DISK_BYTES=1073741824 # 文件系统最小剩余安全空间；低于该值拒绝新增写入
MAX_PROCESS_RSS_BYTES=805306368 # Node 进程 RSS 软上限；超限时先清理缓存并暂停新增写入
RESOURCE_MONITOR_INTERVAL_MS=60000 # 资源用量扫描间隔，单位毫秒

# 限流与并发
OPS_RATE_LIMIT=30 # 单客户端每秒允许的操作成本
SAVE_RATE_LIMIT=2 # 单客户端每秒允许的保存次数
SEARCH_RATE_LIMIT=100 # 单 IP 在搜索窗口内允许的请求数
SEARCH_RATE_WINDOW_MS=10000 # 搜索限流窗口，单位毫秒
ASSET_UPLOAD_RATE_LIMIT=30 # 单 IP 在上传窗口内允许的上传次数
ASSET_UPLOAD_RATE_WINDOW_MS=60000 # 上传限流窗口，单位毫秒
ASSET_UPLOAD_CONCURRENCY=4 # 服务端同时处理的上传请求数
ASSET_UPLOAD_GRANT_TTL_MS=600000 # 新上传资源临时引用授权有效期，单位毫秒
API_WRITE_RATE_LIMIT=300 # 单 IP 在 API 写入窗口内允许的请求数
API_WRITE_RATE_WINDOW_MS=60000 # API 写入限流窗口，单位毫秒
AUTH_RATE_LIMIT=30 # 单 IP 在认证窗口内允许的认证请求数
AUTH_RATE_WINDOW_MS=600000 # 认证限流窗口，单位毫秒
SESSION_READ_RATE_LIMIT=120 # 单 IP 在会话读取窗口内允许的检查次数（内存限流，不写数据库）
SESSION_READ_RATE_WINDOW_MS=60000 # 会话读取限流窗口，单位毫秒

# 数据留存、维护与备份
OPERATION_MAINTENANCE_ENABLED=1 # 操作历史自动维护任务开关
ASSET_GC_ENABLED=1 # 未引用资源自动回收任务开关
AUTOMATIC_BACKUPS_ENABLED=1 # SQLite 自动在线备份任务开关
ASSET_GC_MIN_AGE_MS=604800000 # 未引用资源删除前的最小年龄，单位毫秒
ASSET_GC_INTERVAL_MS=21600000 # 未引用资源清理间隔，单位毫秒
OP_RETENTION_MS=2592000000 # 已提交操作历史保留时间，单位毫秒
OP_RECEIPT_LIMIT=10000 # 单画板最多保留的操作回执数
MAINTENANCE_INTERVAL_MS=3600000 # 操作历史维护任务间隔，单位毫秒
ACCOUNT_CLEANUP_INTERVAL_MS=60000 # 过期认证数据后台清理间隔，单位毫秒
BACKUP_INTERVAL_MS=86400000 # SQLite 自动在线备份间隔，单位毫秒
BACKUP_RETENTION_COUNT=7 # 本地自动备份最多保留份数
BACKUP_INITIAL_DELAY_MS=5000 # 服务启动后首次备份延迟，单位毫秒
SHUTDOWN_GRACE_MS=10000 # 优雅关停等待在途任务的最长时间，单位毫秒
PRIVACY_LOCK_IDLE_MS=900000 # 无操作后显示隐私遮罩的时间，单位毫秒

# 内嵌规划：验收后改为 1，画布和笔记保持现有两种模式
PLANNING_ENABLED=0
